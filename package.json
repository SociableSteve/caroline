{
  "name": "caroline-oss",
  "version": "1.0.0",
  "description": "A single-user, self-hosted GTD system that collects work from GitHub, Gmail and Calendar",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:seed": "tsx tools/demo/seed.ts",
    "demo:shoot": "node tools/demo/shoot.mjs",
    "demo:measure": "node tools/demo/measure.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SociableSteve/caroline.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/SociableSteve/caroline/issues"
  },
  "homepage": "https://github.com/SociableSteve/caroline#readme",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/static": "^8.1.1",
    "ajv": "^8.20.0",
    "fastify": "^5.2.1",
    "openai": "^7.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
