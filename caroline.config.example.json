{
  "server": {
    "host": "127.0.0.1",
    "port": 5123
  },
  "database": {
    "path": "./data/caroline.db"
  },
  "tasks": {
    "waitingStaleDays": 7
  },
  "jobs": {
    "timezone": "Europe/London",
    "schedules": {
      "sync": "*/15 * * * *",
      "classify": "5 * * * *",
      "plan": "30 7 * * *",
      "purge": "20 3 * * *"
    },
    "backoffBaseMinutes": 1,
    "backoffCeilingMinutes": 60,
    "retainRunDays": 30,
    "startupStaggerSeconds": 5
  },
  "classification": {
    "batchSize": 50,
    "confidenceThreshold": 0.75,
    "concurrency": 3
  },
  "chat": {
    "maxToolCalls": 25,
    "bulkConfirmThreshold": 10,
    "contextMessages": 40
  },
  "planning": {
    "workingWindow": { "start": "09:00", "end": "17:30" },
    "workingDays": [1, 2, 3, 4, 5],
    "reservePercent": 20,
    "defaultEstimateMinutes": 30,
    "countAllDayEvents": false,
    "includeReviews": true
  },
  "privacy": {
    "llmContent": "snippet",
    "storeContent": "metadata",
    "snippetChars": 300,
    "retainContentDays": 30,
    "allowFullContentToRemoteProvider": false
  },
  "llm": {
    "provider": "none",
    "model": null,
    "baseUrl": null,
    "maxTokens": 4096,
    "timeoutMs": 60000,
    "budget": {
      "currency": "USD",
      "period": "month",
      "anthropic": "unlimited",
      "openai": "unlimited",
      "ollama": "unlimited"
    },
    "overrides": {}
  },
  "integrations": {
    "github": { "enabled": true, "returnToReviewOnNewCommits": true },
    "google": {
      "enabled": true,
      "clientId": null,
      "gmailQuery": "in:inbox -category:promotions -category:social",
      "calendarIds": [],
      "calendarLookbackDays": 1,
      "calendarLookaheadDays": 14
    }
  }
}
